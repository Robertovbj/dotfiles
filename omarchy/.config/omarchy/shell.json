{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "reidenxerx.omagram"
        },
        {
          "id": "levi.youtube-music"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "yoyo.notification-center"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "io.github.prudhviy99.parametric-eq"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "io.github.guillechuma.trystation"
        },
        {
          "id": "jrmmhm.pocket",
          "members": "yoyo.notification-center, omarchy.monitor, io.github.prudhviy99.parametric-eq, omarchy.network, omarchy.agents, io.github.guillechuma.trystation, omaplug"
        }
      ]
    }
  },
  "plugins": []
}
